APP_NAME=Raycode
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=raycode
DB_USERNAME=root
DB_PASSWORD=

# Alternatif SQLite untuk dev cepat tanpa MySQL:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MIDTRANS_SERVER_KEY=SB-Mid-server-DemoServerKey123456
MIDTRANS_CLIENT_KEY=SB-Mid-client-DemoClientKey123456
MIDTRANS_IS_PRODUCTION=false
VITE_MIDTRANS_CLIENT_KEY="${MIDTRANS_CLIENT_KEY}"

# Notifikasi WA - opsional, kosongkan untuk pakai wa.me link manual (tanpa API)
# Opsi 1: Fonnte (https://fonnte.com) — isi token saja
FONNTE_TOKEN=
# Opsi 2: Generic WA Gateway (Wablas, WATI, dll)
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
WA_GATEWAY_SENDER=

# Analytics (P0-4) — kosongkan untuk disable, isi untuk enable
# GA4: G-XXXXXXXXXX dari https://analytics.google.com
GA_MEASUREMENT_ID=
VITE_GA_MEASUREMENT_ID="${GA_MEASUREMENT_ID}"
# Plausible self-host / cloud (alternative ke GA, privacy-friendly)
PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_DOMAIN="${PLAUSIBLE_DOMAIN}"
# Google Search Console verification (opsional)
GOOGLE_SITE_VERIFICATION=

# SSR: set false untuk matikan build SSR di shared hosting (hemat 40% build time) — PRD Sprint1 FR-6
APP_SSR=false
VITE_SSR=false

